rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Photos collection - any authenticated user can read/write
    match /photos/{photoId} {
      allow read: if request.auth != null || true;
      allow write: if request.auth != null || true;
    }
    
    // Parents collection - allow read/write for registration
    match /parents/{parentId} {
      allow read, write: if request.auth != null || true;
    }
    
    // Children collection - allow read/write for registration
    match /children/{childId} {
      allow read, write: if request.auth != null || true;
    }
    
    // Allow all other operations
    match /{document=**} {
      allow read, write: if request.auth != null || true;
    }
  }
}
